# ── Serveur ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MariaDB / XAMPP ─────────────────────────────────────────────────
# Démarrez XAMPP → Apache + MySQL, puis créez la base via phpMyAdmin :
#   CREATE DATABASE niagara_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=niagara_db
DB_USER=root
DB_PASS=
# Si vous avez défini un mot de passe dans XAMPP, remplissez DB_PASS

# ── JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=changez_moi_minimum_32_caracteres_access
JWT_REFRESH_SECRET=changez_moi_minimum_32_caracteres_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cloudinary (upload images) ────────────────────────────────────
# Laissez vide pour utiliser l'aperçu local Base64
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optionnel) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Session ───────────────────────────────────────────────────────
SESSION_SECRET=changez_moi_session_secret
